import "dotenv/config";import {createConnection} from "mysql2/promise";if(!process.env.DATABASE_URL)throw Error("DATABASE_URL required");const db=await createConnection(process.env.DATABASE_URL);
try{await db.query("CREATE TABLE IF NOT EXISTS refund_cases (jobId INT PRIMARY KEY,proposerId INT NOT NULL,amount DECIMAL(10,2) NOT NULL,reason TEXT NOT NULL,status ENUM('proposed','approved','processing','settled','escalated','needs_review') NOT NULL DEFAULT 'proposed',stripeRefundId VARCHAR(255) NULL,approvedAt TIMESTAMP NULL,createdAt TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,updatedAt TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,KEY refund_cases_status_idx(status,updatedAt)) ENGINE=InnoDB");console.log("Refund settlement table ready; existing payments unchanged.");}finally{await db.end();}
