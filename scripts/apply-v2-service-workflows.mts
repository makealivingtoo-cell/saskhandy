import "dotenv/config";import {createConnection} from "mysql2/promise";if(!process.env.DATABASE_URL)throw Error("DATABASE_URL required");const db=await createConnection(process.env.DATABASE_URL);
try{await db.query("CREATE TABLE IF NOT EXISTS recurring_requests (id INT AUTO_INCREMENT PRIMARY KEY,homeownerId INT NOT NULL,handymanId INT NOT NULL,title VARCHAR(160) NOT NULL,description TEXT NOT NULL,category VARCHAR(100) NOT NULL,location VARCHAR(255) NOT NULL,intervalDays INT NOT NULL,nextRunAt TIMESTAMP NOT NULL,lastJobId INT NULL,status ENUM('active','paused','ended') NOT NULL DEFAULT 'active',createdAt TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,KEY recurring_owner_idx(homeownerId),KEY recurring_due_idx(status,nextRunAt)) ENGINE=InnoDB");await db.query("CREATE TABLE IF NOT EXISTS job_additions (id INT AUTO_INCREMENT PRIMARY KEY,parentJobId INT NOT NULL,childJobId INT NOT NULL,requestKey VARCHAR(36) NOT NULL,createdAt TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,UNIQUE KEY addition_key_idx(requestKey),UNIQUE KEY addition_child_idx(childJobId),KEY addition_parent_idx(parentJobId)) ENGINE=InnoDB");console.log("Service workflows tables ready; existing jobs unchanged.");}finally{await db.end();}
